# Copy this file to .env.local and fill in your values
NEXT_PUBLIC_API_URL=https://api.koralink.sa
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_MOYASAR_KEY=pk_your_moyasarkeyhere
NEXT_PUBLIC_APP_URL=https://app.koralink.sa

# P0-7 (run #26): Build-time exclusion of the DevLoginBar component. Set to
# 'true' for any deployment that is NOT a developer box — the component (and
# the seeded-phone list) will be tree-shaken from the bundle. The API
# independently enforces the gate via DEV_LOGIN_ENABLED.
NEXT_PUBLIC_DISABLE_DEV_LOGIN_BAR=true
