# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://koralink:koralink_dev@localhost:5432/koralink
SSL_MODE=false

# ── Redis (cache + future OTP store) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
COOKIE_SECRET=change-me-to-another-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
PLAYER_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
PORT=3001

# ── Unifonic SMS (optional — dev works without it) ───────────────────────────
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=KoraLink

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
