# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://koralink:koralink_dev@localhost:5432/koralink
SSL_MODE=false
# Pool tuning (run #43) — fail-fast so a DB stall can't wedge requests.
# Defaults: 10 / 30 / 10 (connections / idle seconds / connect seconds).
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10

# ── Redis (cache + future OTP store) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Socket.IO Redis adapter (opt-in — multi-instance scaling; false = in-memory)
WS_REDIS_ADAPTER=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# MUST be set to real random values. The API refuses to boot on placeholder/empty
# secrets (see src/common/security/bootstrap-secrets.ts). Generate with:
#   openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
PLAYER_URL=http://localhost:3000

# ── Transactional email (P1-41, run #35; provider port added no-domain cycle) ──
# EMAIL_PROVIDER selects the transport: "resend" (default) or "brevo".
#   resend → RESEND_API_KEY + RESEND_FROM. NOTE: without a verified sending
#     domain, Resend ONLY delivers to the account owner's own address.
#   brevo  → BREVO_API_KEY + BREVO_FROM. Brevo delivers to ANY recipient once
#     a single sender address is verified in the Brevo console (no domain
#     needed) — the pre-domain path for OTP to real inboxes.
# Both adapters log instead of sending when their API key is EMPTY (safe
# dev/test default). MAIL_FROM is legacy Resend naming kept for reference.
# API_PUBLIC_URL is the externally-reachable API origin used to build email
# verification links (falls back to PLAYER_URL when unset).
BREVO_API_KEY=
BREVO_FROM=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
API_PUBLIC_URL=
ADMIN_URL=http://localhost:3002
PORT=3001

# ── Unifonic SMS (optional — dev works without it) ───────────────────────────
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=KoraLink

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Feature flags (P0-7, run #26) ───────────────────────────────────────────
# Both default to DISABLED. The KoraLink API does NOT fall back to NODE_ENV for
# these — that pattern was the run-#25 Strix finding (CVSS 9.1 admin bypass via
# dev-login + free wallet credit on a Tailscale-reachable deployment that ran
# with NODE_ENV=development). Operators must explicitly opt-in.
#
# DEV_LOGIN_ENABLED=true  — allow POST /auth/dev-login (dev box only).
# WALLET_TOPUP_ENABLED=true — allow POST /wallet/topup (dummy self-credit).
#
# Live Tailscale deployment: leave both UNSET (false). Dev box: set true.
DEV_LOGIN_ENABLED=false
WALLET_TOPUP_ENABLED=false

# ── Push notifications (P0-8, run #26) ──────────────────────────────────────
# Comma-separated extra hostnames to allowlist for push subscription endpoints
# (besides the built-in FCM/Mozilla/Apple/Windows defaults in
# src/common/security/push-endpoint.validator.ts). Use for Huawei HMS,
# Samsung push, or any operator-owned relay.
ADMIN_PUSH_HOST_ALLOWLIST=
