# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://koralink:koralink_dev@localhost:5432/koralink
SSL_MODE=false
# Pool tuning (run #43) — fail-fast so a DB stall can't wedge requests.
# Defaults: 10 / 30 / 10 (connections / idle seconds / connect seconds).
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10

# ── Redis (cache + future OTP store) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Socket.IO Redis adapter (opt-in — multi-instance scaling; false = in-memory)
WS_REDIS_ADAPTER=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# MUST be set to real random values. The API refuses to boot on placeholder/empty
# secrets (see src/common/security/bootstrap-secrets.ts). Generate with:
#   openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# PLAYER_URL / ADMIN_URL are comma-separated origin allowlists (credentials:true).
# Note: if users hit the PWA funnel over plain http (stale bookmarks/scripts —
# Sentry KORALINK-API-B), ALSO list the http:// variant of that host:port.
# Example: PLAYER_URL=https://host:10000,http://host:10000
PLAYER_URL=http://localhost:3000

# ── Transactional email (P1-41, run #35; provider port added no-domain cycle) ──
# EMAIL_PROVIDER selects the transport: "resend" (default) or "brevo".
#   resend → RESEND_API_KEY + RESEND_FROM. NOTE: without a verified sending
#     domain, Resend ONLY delivers to the account owner's own address.
#   brevo  → BREVO_API_KEY + BREVO_FROM. Brevo delivers to ANY recipient once
#     a single sender address is verified in the Brevo console (no domain
#     needed) — the pre-domain path for OTP to real inboxes.
# Both adapters log instead of sending when their API key is EMPTY (safe
# dev/test default). MAIL_FROM is legacy Resend naming kept for reference.
# API_PUBLIC_URL is the externally-reachable API origin used to build email
# verification links (falls back to PLAYER_URL when unset).
BREVO_API_KEY=
BREVO_FROM=
# Transport for transactional email (OTP + notifications). Unset defaults to
# resend. Production-like runtimes (production | staging) FAIL AT BOOT unless
# the chosen transport's env is complete (brevo: BREVO_API_KEY+BREVO_FROM,
# resend: RESEND_API_KEY) — see common/security/email-delivery.ts (D-20261119-02).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
API_PUBLIC_URL=
ADMIN_URL=http://localhost:3002
PORT=3001

# ── Unifonic SMS (optional — dev works without it) ───────────────────────────
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=KoraLink

# ── Security posture flags (P1-72, run #188 — Strix run-#183 MEDIUM) ──────────
# COOKIE_SECURE: force auth cookies secure:true/false explicitly. Unset keeps
#   the legacy NODE_ENV=production derivation (zero behavior change).
#   Staging recommendation once TLS termination is confirmed end-to-end: true.
#   STRICT: only true/false/unset accepted — any other value aborts the boot
#   (fail-loud, PR-Agent r1), and COOKIE_SECURE=false is refused in production.
# COOKIE_SECURE=false
# SWAGGER_ENABLED: force /api/docs ON/OFF explicitly. Unset keeps the legacy
#   derivation (ON everywhere except NODE_ENV=production). Strict values only
#   (true/false/unset — anything else aborts the boot).
#   Staging recommendation (P1-72): SWAGGER_ENABLED=false
# SWAGGER_ENABLED=false
NODE_ENV=development

# ── Feature flags (P0-7, run #26) ───────────────────────────────────────────
# Both default to DISABLED. The KoraLink API does NOT fall back to NODE_ENV for
# these — that pattern was the run-#25 Strix finding (CVSS 9.1 admin bypass via
# dev-login + free wallet credit on a Tailscale-reachable deployment that ran
# with NODE_ENV=development). Operators must explicitly opt-in.
#
# DEV_LOGIN_ENABLED=true  — allow POST /auth/dev-login (dev box only).
# WALLET_TOPUP_ENABLED=true — enable the REAL Moyasar top-up flow
#   (POST /wallet/topup/intent + /verify). The legacy dummy self-credit route
#   was removed in P2-331; this flag gates ONLY Moyasar now.
#
# Live Tailscale deployment: leave both UNSET (false). Dev box: set true.
DEV_LOGIN_ENABLED=false
WALLET_TOPUP_ENABLED=false

# ── F2: Moyasar webhook (run #223) — default OFF ────────────────────────────
# WALLET_WEBHOOK_ENABLED=true — accept Moyasar webhook events at
#   POST /api/v1/wallet/webhook (real-time credit; closes the P2-369c
#   newest-100 list-window gap). Requires the top-up flag + keys.
# MOYASAR_WEBHOOK_SECRET — the shared_secret YOU assign when registering the
#   webhook (Moyasar dashboard → Settings → Webhooks, or POST /v1/webhooks).
#   Every event echoes it back as `secret_token`; the endpoint compares it
#   constant-time and then re-fetches the payment server-side before any
#   credit (the secret gates WHO CAN ASK, never WHAT landed).
#   Generate one with: openssl rand -hex 32
# Owner steps at go-live: register the webhook URL, paste this secret here,
#   confirm the webhook via the 6-digit code the endpoint logs + pages to
#   Sentry (valid 30 min).
WALLET_WEBHOOK_ENABLED=false
# MOYASAR_WEBHOOK_SECRET=

# ── Push notifications (P0-8, run #26) ──────────────────────────────────────
# Comma-separated extra hostnames to allowlist for push subscription endpoints
# (besides the built-in FCM/Mozilla/Apple/Windows defaults in
# src/common/security/push-endpoint.validator.ts). Use for Huawei HMS,
# Samsung push, or any operator-owned relay.
ADMIN_PUSH_HOST_ALLOWLIST=

# Trust proxy: how many ingress hops sit in front of the API. req.ip (and the
# per-IP OTP caps + audit-log attribution keyed on it) is only as honest as
# this number. DEFAULT 0 = direct exposure — flipping this on WITHOUT a proxy
# makes X-Forwarded-For ATTACKER-CONTROLLED (defeats the OTP caps).
# Set to 1 ONLY when the API sits behind exactly ONE ingress that OVERWRITES
# X-Forwarded-For (our topology: Traefik on the VPS, Render's edge in prod).
# More hops? Count them. No proxy? Keep 0.
TRUST_PROXY=0

# ── Web Push VAPID keys (P1-66, run #135) ──────────────────────────────────
# Generate with: npx web-push generate-vapid-keys — push notifications stay disabled without these
# The PWA needs the SAME public key as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@koralink.sa

# ── Cloudflare Turnstile OTP gate (F1 launch lane) ─────────────────────────
# Keys come from the Cloudflare dashboard (Turnstile widget → site key + secret).
# TURNSTILE_ENABLED unset/false = gate fully inert (zero behavior change).
# Cloudflare's public dummy secrets (e.g. 1x…AA always-pass) are for
# staging/CI ONLY — the always-pass dummy is rejected at boot in production.
TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Self-hosted SeaweedFS S3 storage (P1-38 venues / P2-50 avatars) ─────────
# Staging-only infra today (koralink-storage.service on the VPS, 127.0.0.1:8333).
# Venue uploads need: S3_ENDPOINT (EXPLICIT — the built-in localhost default is
# a dev convenience, not configuration, P2-385b run #217) + S3_BUCKET_VENUES +
# S3_ACCESS_KEY + S3_SECRET_KEY. Avatar uploads need the SAME four keys plus
# S3_BUCKET_AVATARS. S3_REGION is optional (defaults us-east-1). Without the
# required set: venue/avatar reads degrade to 404 + a one-time warn (P2-385c)
# and uploads 503 typed instead of 500. Absent entirely = boot stays healthy
# (run #216 P0), media surfaces degrade typed. NEVER add these to Render prod
# env unless prod intentionally couples to the VPS storage (owner decision —
# rejected 2026-11-18, DECISIONS.md).
S3_ENDPOINT=
S3_BUCKET_VENUES=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_AVATARS=
