{
  "name": "koralink",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.1",
  "overrides": {
    "ws": "^8.21.0",
    "engine.io": "^6.6.7",
    "ws@>=8.0.0 <8.21.0": "$ws@^8.21.0",
    "@sentry/nextjs": "10.70.0",
    "@sentry/server-utils": "10.70.0",
    "@sentry/core": "10.70.0",
    "@sentry/node": "10.70.0",
    "@sentry/react": "10.70.0",
    "@sentry/browser": "10.70.0"
  }
}
